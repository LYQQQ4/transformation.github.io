{
  "name": "transport-order-management",
  "version": "1.0.0",
  "description": "Full-stack web app for transport order management",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:prod": "NODE_ENV=production node backend/server.js",
    "check": "eslint . --ext .js",
    "migrate:user-profiles": "node scripts/migrate_user_profiles.js",
    "rollback:user-profiles": "node scripts/rollback_user_profiles_migration.js",
    "test:smoke": "node scripts/api_module_smoke.js",
    "test:billing": "node scripts/billing_template_test.js",
    "test:billing-formula": "node scripts/billing_formula_test.js",
    "test:order-summary": "node scripts/order_management_feature_test.js && node scripts/report_management_feature_test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "node-fetch": "^3.3.2",
    "sqlite3": "^5.1.6",
    "xlsx": "^0.18.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^9.39.2"
  }
}
