# ============================================
# 服务器部署环境配置文件
# 将此文件复制为 .env 并根据实际情况修改
# ============================================

# ============================================
# 应用基本配置
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# 数据库配置 - order_system (订单系统)
# ============================================
# 数据库连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=order_system

# 连接池配置
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=60000
DB_SSL=false

# ============================================
# 数据库配置 - user_system (用户系统)
# ============================================
# 如果用户系统与订单系统使用同一数据库服务器，
# 可以省略这部分，会自动使用上面的配置
USER_DB_HOST=127.0.0.1
USER_DB_PORT=3306
USER_DB_USER=root
USER_DB_PASSWORD=your_secure_password_here
USER_DB_NAME=user_system

# ============================================
# 安全配置
# ============================================
# CORS允许的源（企业内网IP或域名，多个用逗号分隔）
# 示例：CORS_ORIGIN=http://192.168.1.100:3000,http://orders.company.local
CORS_ORIGIN=http://localhost:3000

# 是否允许 null origin（来自文件系统的请求）
ALLOW_NULL_ORIGIN=false

# ============================================
# 文件路径配置
# ============================================
# 日志目录
LOG_DIR=C:\transform\logs

# 上传目录
UPLOAD_DIR=C:\transform\uploads

# ============================================
# PM2 进程管理配置（生产环境）
# ============================================
# PM2 实例数（0 = CPU 核心数）
PM2_INSTANCES=max

# PM2 日志文件路径
PM2_LOG_FILE=C:\transform\logs\pm2.log
PM2_ERROR_LOG=C:\transform\logs\pm2-error.log
PM2_OUT_LOG=C:\transform\logs\pm2-out.log

# ============================================
# 应用部署路径
# ============================================
# 应用根目录（Windows Server）
APP_ROOT=C:\transform

# 后端目录
BACKEND_DIR=C:\transform\backend

# 前端目录
FRONTEND_DIR=C:\transform\frontend
